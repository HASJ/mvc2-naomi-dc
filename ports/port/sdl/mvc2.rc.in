#include <winver.h>

1 ICON "@RC_ICON@"

1 VERSIONINFO
FILEVERSION @RC_V1@,@RC_V2@,@RC_V3@,0
PRODUCTVERSION @RC_V1@,@RC_V2@,@RC_V3@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "mvc2-naomi-dc"
            VALUE "FileDescription", "@RC_DESCRIPTION@"
            VALUE "FileVersion", "@MVC2_VERSION@"
            VALUE "InternalName", "@TARGET@"
            VALUE "OriginalFilename", "@TARGET@.exe"
            VALUE "ProductName", "mvc2-naomi-dc"
            VALUE "ProductVersion", "@MVC2_VERSION@"
            VALUE "Comments", "A fan port built from the mvc2-naomi-dc decompilation. Not affiliated with Capcom or Sega. No game data included."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
